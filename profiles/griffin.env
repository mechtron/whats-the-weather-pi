# Copy to ~/soundbox/.env on Griffin's Pi, then add your API keys.
# cp profiles/griffin.env ~/soundbox/.env

GEMINI_API_KEY=
WEATHER_API_KEY=

CHILD_NAME=Griffin
VOICE_NAME=Achird
LOCATION=LAGUNA_HILLS
CLOSING_MESSAGE=We love you so much Little Dude! You are so sweet, a great little brother, and we love you just the way you are! Love, Mommy and Daddy.
