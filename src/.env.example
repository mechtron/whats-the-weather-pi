# Copy to .env on each Raspberry Pi and fill in values for that sound box.
# See profiles/maeve.env and profiles/griffin.env for ready-made profiles.

GEMINI_API_KEY=your_gemini_api_key_here
WEATHER_API_KEY=your_weather_api_key_here

# Who this sound box greets
CHILD_NAME=Maeve

# Gemini TTS voice (e.g. Kore, Puck, Charon, Fenrir, Aoede)
VOICE_NAME=Kore

# Weather location for WeatherAPI.com
LOCATION=LAGUNA_HILLS

# Personalized closing message (single line)
CLOSING_MESSAGE=We love you so much Maevey! We are proud of you. You are so cute and talented, and you are perfect just the way you are! Love, Mommy and Daddy.
